# syntax=docker/dockerfile:1.7
# Next.js shell (web/apps/web) as a standalone server (`output: "standalone"`).
# Build context: repository root.
#   docker build -f deploy/Dockerfile.web -t q2web/web .
# The browser reaches /api, /assets and /ws on the same origin (Caddy routes them to the Go server, see
# deploy/Caddyfile). Build args (baked in at build time by Next.js):
#   Q2_SERVER_URL          upstream of the fallback rewrites when the app is hit directly (default http://server:8080)
#   NEXT_PUBLIC_Q2_SERVER  optional browser-visible Go server origin for direct WebSocket connections
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm-slim AS deps
WORKDIR /src/web
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
# manifests first for layer caching; workspace packages are consumed from source (exports ./src/index.ts)
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
COPY web/packages ./packages
COPY web/apps/web/package.json ./apps/web/package.json
RUN --mount=type=cache,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --filter web... --config.confirmModulesPurge=false

FROM deps AS build
ARG Q2_SERVER_URL=http://server:8080
ARG NEXT_PUBLIC_Q2_SERVER=
ENV NEXT_TELEMETRY_DISABLED=1 Q2_SERVER_URL=${Q2_SERVER_URL} NEXT_PUBLIC_Q2_SERVER=${NEXT_PUBLIC_Q2_SERVER}
COPY web/tsconfig.base.json ./
COPY web/apps/web ./apps/web
# prebuild bundles the q2-sound AudioWorklet into public/, then next build emits .next/standalone
RUN pnpm --filter web build

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
# standalone output is rooted at the workspace (outputFileTracingRoot = web/)
COPY --from=build --chown=node:node /src/web/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /src/web/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /src/web/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
