# syntax=docker/dockerfile:1.7
# Next.js shell (web/apps/web) as a standalone server. Placeholder until the
# app exists: it requires `output: "standalone"` in next.config.
# Build context: repository root.
#   docker build -f deploy/Dockerfile.web -t q2web/web .
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm-slim AS deps
WORKDIR /src/web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
COPY web/packages ./packages
COPY web/apps ./apps
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile

FROM deps AS build
COPY web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm -r build && pnpm --filter ./apps/web build

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /src/web/apps/web/.next/standalone ./
COPY --from=build /src/web/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /src/web/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
