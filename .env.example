# Copy to .env (git-ignored). All variables are optional; defaults shown.
# Read by the Go server (server/internal/config) and docker-compose.dev.yml.

# HTTP listen address of the Go server.
Q2_HTTP_ADDR=:8080

# Postgres connection string. Empty = in-memory repository (dev only; data lost on restart).
DATABASE_URL=postgres://q2:q2@localhost:5432/q2?sslmode=disable

# Run goose migrations on startup (under a Postgres advisory lock).
Q2_MIGRATE=true

# Content-addressed blob store: a directory or file:///abs/path (s3:// not implemented yet).
Q2_BLOB_DIR=./data/blobs

# Spool directory for uploads (default: <blob dir>/tmp, same filesystem for cheap renames).
Q2_UPLOAD_DIR=

# Demo pak ingested as the public pakset "demo" on startup ("off" disables).
Q2_DEMO_PAK=assets/demo/baseq2/pak0.pak

# Maximum pak upload size in bytes (1 GiB).
Q2_MAX_UPLOAD_BYTES=1073741824

# Parallel ingest jobs.
Q2_INGEST_WORKERS=1

# Session cookie: Secure flag (set false for plain-http development) and lifetime.
Q2_COOKIE_SECURE=true
Q2_SESSION_TTL=720h

# Extra browser origins allowed to call the API with credentials (comma separated),
# e.g. the Next.js dev server.
Q2_CORS_ORIGINS=http://localhost:3000

# Take the client IP from X-Forwarded-For (enable behind Caddy).
Q2_TRUST_PROXY=false

# Public base URL for game WebSockets (empty = same origin as the API).
Q2_PUBLIC_WS_URL=

# Logging: debug|info|warn|error, json|text.
Q2_LOG_LEVEL=info
Q2_LOG_FORMAT=json

# Tests: a Postgres server URL; DB tests create and drop their own databases on it.
# DATABASE_URL_TEST=postgres://postgres:test@localhost:55432/postgres?sslmode=disable

# upload quotas per account (admins exempt)
Q2_MAX_USER_PAKS=50
Q2_USER_QUOTA_BYTES=4294967296

# ---- AI bots (agent/runner.Manager: /api/v1/bots, /ws/v1/bots/{id}/{watch,decisions}) ----
# Turn the bots API on. Off: every /api/v1/bots endpoint answers 503.
Q2_BOTS_ENABLED=false
# Bots running at once (all owners), and per account (administrators are exempt from the latter).
Q2_BOTS_MAX=4
Q2_BOTS_PER_USER=1
# Let accounts that are not administrators start bots with a local backend (scripted, mock,
# constant, random). The Jev backend (paid API) is always administrators only.
Q2_BOTS_ALLOW_USERS=false
# Live viewers per bot (the watch stream; the decisions feed has the same cap). One address
# holds at most 4 of each stream's connections to a bot, and asking for watch tickets is
# rate-limited (30/min per account, or per IP for anonymous viewers of public bots).
Q2_BOT_MAX_VIEWERS=8
# Run directories (run.json, traces, .dm2 demos); q2bot CLI runs written here are listed too.
# Ended runs kept, newest first (0 keeps all); at most 10 of them are one account's
# (administrators', the server's and CLI runs are not capped). An account that is not an
# administrator starts at most 10 bots per 10 minutes.
Q2_BOT_RUNS_DIR=./data/bots
Q2_BOT_RUNS_KEEP=50
# Wall-clock limit of one bot run.
Q2_BOT_MAX_RUN=30m
# Spend caps in USD: per model-backed run, and per UTC day over every Jev bot (persisted in the
# database; 0 disables a cap).
Q2_BOT_BUDGET_USD_PER_RUN=1
Q2_BOT_BUDGET_USD_PER_DAY=5

# Jev (TypeSafe System One) API key. SERVER SIDE ONLY: never put it in a NEXT_PUBLIC_* variable or
# the web app. It is redacted from logs, traces and API responses. Empty: the jev backend is off.
TYPESAFE_API_KEY=
# Jev API base URL (empty: https://api.typesafe.ai). https unless loopback; the key is only sent to
# a custom base when JEV_ALLOW_CUSTOM_BASE=true (e.g. a local system-one-adapter).
JEV_BASE_URL=
JEV_ALLOW_CUSTOM_BASE=false
# Pinned Jev model (moving aliases such as jev-latest are refused).
Q2_JEV_MODEL=jev-1.13.0
# Requests per second of every Jev bot together (the account's rate limit; 0: none).
Q2_JEV_MAX_QPS=20
# Nav graph cache and route tables (defaults: <repo>/assets/nav and <repo>/fixtures/agent/routes).
# Q2_NAV_DIR=
# Q2_ROUTES_DIR=
