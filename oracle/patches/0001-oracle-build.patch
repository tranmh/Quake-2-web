diff -ru -a orig/qcommon/cmodel.c src/qcommon/cmodel.c
--- orig/qcommon/cmodel.c	2026-10-07 19:25:39.996796854 +0200
+++ src/qcommon/cmodel.c	2026-10-07 19:32:34.603969253 +0200
@@ -103,6 +103,7 @@
 int			numclusters = 1;
 
 mapsurface_t	nullsurface;
+mapsurface_t	oracle_badsurface;	// target of brush sides with texinfo < 0 (oracle patch)
 
 int			floodvalid;
 
@@ -432,7 +433,12 @@
 		j = LittleShort (in->texinfo);
 		if (j >= numtexinfo)
 			Com_Error (ERR_DROP, "Bad brushside texinfo");
-		out->surface = &map_surfaces[j];
+		// qbsp writes texinfo -1 for bevel sides; &map_surfaces[-1] points before the array, at
+		// whatever the linker placed there. Pin it to the all-zero surface the fixtures assume.
+		if (j < 0)
+			out->surface = &oracle_badsurface;
+		else
+			out->surface = &map_surfaces[j];
 	}
 }
 
